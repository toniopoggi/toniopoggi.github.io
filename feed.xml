---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  <author><name>Antonio Poggi</name></author>
  {% assign sorted_articles = site.articles | sort: 'date' | reverse %}
  {% for article in sorted_articles limit: 20 %}
  <entry>
    <title>{{ article.title | xml_escape }}</title>
    <link href="{{ article.url | absolute_url }}"/>
    <published>{{ article.date | date_to_xmlschema }}</published>
    <updated>{{ article.last_modified_at | default: article.date | date_to_xmlschema }}</updated>
    <id>{{ article.url | absolute_url }}</id>
    <summary>{{ article.description | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
