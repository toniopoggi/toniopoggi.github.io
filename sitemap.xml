---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/visokio/' | absolute_url }}</loc></url>
  <url><loc>{{ '/visokio/timeline/' | absolute_url }}</loc></url>
  <url><loc>{{ '/visokio/whole-data-journey/' | absolute_url }}</loc></url>
  <url><loc>{{ '/visokio/data-apps/' | absolute_url }}</loc></url>
  <url><loc>{{ '/visokio/verifiable-ai/' | absolute_url }}</loc></url>
  <url><loc>{{ '/air-quality/' | absolute_url }}</loc></url>
  <url><loc>{{ '/writing/' | absolute_url }}</loc></url>
  <url><loc>{{ '/directory/' | absolute_url }}</loc></url>
  <url><loc>{{ '/about/' | absolute_url }}</loc></url>
  <url><loc>{{ '/llms.txt' | absolute_url }}</loc></url>
  {% for article in site.articles %}
  <url>
    <loc>{{ article.url | absolute_url }}</loc>
    <lastmod>{{ article.last_modified_at | default: article.date | date_to_xmlschema }}</lastmod>
    {% if article.image %}
    <image:image>
      <image:loc>{{ article.image | absolute_url }}</image:loc>
      <image:caption>{{ article.image_caption | default: article.image_alt | strip_html | xml_escape }}</image:caption>
    </image:image>
    {% endif %}
  </url>
  {% endfor %}
</urlset>
